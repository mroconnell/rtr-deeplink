# Copy to .env for local dev if you want to point at a real Postgres
# instance. If unset, falls back to a local SQLite file (archive_dev.db) --
# a separate file from the resolver's dev.db, so the two services' local
# schemas never collide.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret for the private /internal/lookup and /internal/ingest
# endpoints the resolver calls. Must match the resolver's
# ARCHIVE_INGEST_TOKEN exactly -- it's one shared secret between the two
# services, not a pair of independent credentials.
ARCHIVE_INGEST_TOKEN=changeme

# The public domain these pages are actually reached at (via the resolver's
# /m/* proxy) -- used only for <link rel="canonical">/OpenGraph tags so
# search engines don't see this service's own onrender.com URL as a
# separate, duplicate page. Leave unset locally; canonical tags are simply
# omitted (harmless -- they're a hint, not a requirement). Also used to
# build the emailed link back to a meeting page once a transcription job
# finishes (see worker/main.py's _send_completion_email).
PUBLIC_BASE_URL=https://redtaperecordings.com

# Resend (resend.com) -- same account as the resolver's newsletter signup,
# but used here for two new things neither service did before: checking
# whether an email is already an audience member (skips the confirm-by-
# email step for a transcription request -- see archive/utils/email.py's
# check_audience_membership) and sending real transactional email (the
# confirmation link, and -- from the worker service, which imports this
# same module directly -- the "your transcript is ready" email). The key
# needs "Full access" scope, same requirement as the resolver's newsletter
# integration (a "Sending access"-only key gets rejected on the audiences
# endpoint) -- unverified whether that scope is also sufficient for the
# transactional /emails endpoint used here; confirm against a real account
# before relying on it.
RESEND_API_KEY=re_xxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Must be a verified sending domain/address in Resend, not an arbitrary
# address -- e.g. "Ryan <ryan@ally.redtaperecordings.com>". Avoid a
# noreply@ local part -- Resend's own deliverability guidance flags it as
# a sender-reputation risk.
RESEND_FROM_ADDRESS=
# Optional. Where replies should actually land, if different from
# RESEND_FROM_ADDRESS -- useful when the From address is on a subdomain
# dedicated to sending infrastructure (SPF/DKIM/bounce MX) with no real
# inbox behind it, e.g. "ryan@redtaperecordings.com".
RESEND_REPLY_TO_ADDRESS=

# Social auto-posting (archive/utils/social.py, 2026-08-17) -- announce a
# brand-new, high-quality Archive page (real video + real English
# transcript, no garbled-source warning -- see payload_is_high_quality())
# on Bluesky and/or Mastodon. Leave a network's pair unset to disable that
# network; leave all unset to disable the feature entirely (the default --
# nothing else in this service depends on it). PUBLIC_BASE_URL above must
# also be set, since it's what the posted permalink is built from.
#
# BLUESKY_APP_PASSWORD is an *app password* (Settings > App Passwords in
# the Bluesky client), NEVER the account's real password. The real
# account (registered 2026-08-21):
# https://bsky.app/profile/redtaperecordings.bsky.social
BLUESKY_HANDLE=redtaperecordings.bsky.social
BLUESKY_APP_PASSWORD=
# Only set to use a self-hosted PDS; the default is the main bsky.social.
#BLUESKY_SERVICE_URL=https://bsky.social

# Your instance's base URL (e.g. https://mastodon.social) + an access
# token from Preferences > Development > New application (scope:
# write:statuses is sufficient).
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# Minimum transcript segments before a page is worth announcing --
# outcomes.py counts any non-empty transcript as a successful resolve, but
# a 3-line caption stub isn't worth a public post. Default 50.
#SOCIAL_MIN_SEGMENTS=50

# Minimum seconds between announcements (default 180) -- a burst of
# qualifying new pages posts at most one per window, the rest are skipped
# outright (not queued -- see social.py's _last_announce_at comment). Set
# to 0 to disable the buffer.
#SOCIAL_MIN_POST_INTERVAL_SECONDS=180

# Clerk (accounts, 2026-08-10) -- see requirements.txt's matching comment
# and BACKLOG.md's "Accounts + token billing" section. No webhook secret
# here -- webhook handling lives only on the resolver. Leave unset to
# disable accounts entirely; the rest of this service is unaffected.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Optional -- LEAVE BLANK unless you have a specific reason not to. See
# the root .env.example's matching comment for why: a malformed value
# here fails silently (every real signed-in visitor looks signed out,
# with zero error/crash anywhere), which is strictly worse than leaving
# it unset. Real incident, 2026-08-11 -- see BACKLOG_DONE.md's "Clerk
# production cutover" entry.
CLERK_JWT_KEY=
