# Copy to .env for local dev if you want to point at a real Postgres
# instance. If unset, falls back to a local SQLite file (archive_dev.db) --
# a separate file from the resolver's dev.db, so the two services' local
# schemas never collide.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret for the private /internal/lookup and /internal/ingest
# endpoints the resolver calls. Must match the resolver's
# ARCHIVE_INGEST_TOKEN exactly -- it's one shared secret between the two
# services, not a pair of independent credentials.
ARCHIVE_INGEST_TOKEN=changeme

# The public domain these pages are actually reached at (via the resolver's
# /m/* proxy) -- used only for <link rel="canonical">/OpenGraph tags so
# search engines don't see this service's own onrender.com URL as a
# separate, duplicate page. Leave unset locally; canonical tags are simply
# omitted (harmless -- they're a hint, not a requirement). Also used to
# build the emailed link back to a meeting page once a transcription job
# finishes (see worker/main.py's _send_completion_email).
PUBLIC_BASE_URL=https://redtaperecordings.com

# Resend (resend.com) -- same account as the resolver's newsletter signup,
# but used here for two new things neither service did before: checking
# whether an email is already an audience member (skips the confirm-by-
# email step for a transcription request -- see archive/utils/email.py's
# check_audience_membership) and sending real transactional email (the
# confirmation link, and -- from the worker service, which imports this
# same module directly -- the "your transcript is ready" email). The key
# needs "Full access" scope, same requirement as the resolver's newsletter
# integration (a "Sending access"-only key gets rejected on the audiences
# endpoint) -- unverified whether that scope is also sufficient for the
# transactional /emails endpoint used here; confirm against a real account
# before relying on it.
RESEND_API_KEY=re_xxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Must be a verified sending domain/address in Resend, not an arbitrary
# address -- e.g. "Ryan <ryan@ally.redtaperecordings.com>". Avoid a
# noreply@ local part -- Resend's own deliverability guidance flags it as
# a sender-reputation risk.
RESEND_FROM_ADDRESS=
# Optional. Where replies should actually land, if different from
# RESEND_FROM_ADDRESS -- useful when the From address is on a subdomain
# dedicated to sending infrastructure (SPF/DKIM/bounce MX) with no real
# inbox behind it, e.g. "ryan@redtaperecordings.com".
RESEND_REPLY_TO_ADDRESS=
