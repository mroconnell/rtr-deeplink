{#- Context variables:
     entries (list of entry dicts, published only -- see
       _context_entry.html's own comment for the full per-entry shape)
     base_url (absolute, no trailing slash)
     feed_url (absolute -- this feed's own URL, for atom:link rel="self")

   select_autoescape() keys off the template's real file extension, which
   for a "*.xml.jinja" name is ".jinja" -- not one of the extensions it
   auto-escapes -- so, same as feed.xml.jinja, every interpolated value
   below is escaped explicitly with `|e` rather than relying on that.
   `entry.summary`/`entry.source_label` are editor-written and untrusted
   on top of that, but the same `|e` covers both reasons at once. -#}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
  <title>Red Tape Recordings — Full Context</title>
  <link>{{ base_url|e }}/context</link>
  <description>Clips of public government meetings that travel on social media, linked back to the full recording at the moment they show.</description>
  <atom:link xmlns:atom="http://www.w3.org/2005/Atom" href="{{ feed_url|e }}" rel="self" type="application/rss+xml"/>
{%- for entry in entries %}
  {#- WO-1001: <link> is the entry's OWN page, not the meeting -- an RSS
     reader treats <link> as "the URL for this item," and that item is
     the curated post, not the recording it cites. `entry.permalink`
     (crud._context_entry_dict(), via context_links.context_permalink())
     is present on every entry regardless of status/meeting, so no
     fallback is needed here the way the old meeting-dependent `deep_link`
     one was. <guid> stays untouched on purpose -- changing it would
     re-deliver every already-seen item as new to every subscriber.
     Meeting-dependent fields (title text, deep link) can still be None
     together when has_meeting is false, even though this feed's own
     query (list_context_entries(public=True)) only ever returns entries
     with a real, still-existing meeting -- kept defensive rather than
     assuming that join can never change. WO-945: the editor's own
     `headline`, when set, wins outright over the meeting-title-based
     line below -- it's a title the editor wrote specifically for this
     entry, so it's a better fit for an RSS reader than a generated
     one. -#}
  {%- set item_title = entry.headline or ((entry.title or "A meeting") ~ (" — " ~ entry.jurisdiction_display if entry.jurisdiction_display else "")) %}
  {%- set item_link = base_url ~ entry.permalink %}
  {#- The old <link> target -- the meeting deep link -- moves into the
     description instead, so a reader who only sees the feed still gets
     to the recording the way the old <link> gave them, alongside the
     entry's own page. Omitted entirely when there's no matched meeting
     (draft-shaped defensive case above; never true for a published,
     feed-listed entry today). -#}
  {%- set meeting_note = ((" Watch the full meeting" ~ (" from " ~ entry.timestamp_label if entry.timestamp_label else "") ~ ": " ~ base_url ~ entry.deep_link) if entry.deep_link else "") %}
  <item>
    <title>{{ item_title|e }}</title>
    <link>{{ item_link|e }}</link>
    <guid isPermaLink="false">rtr-context-{{ entry.id }}</guid>
    {%- if entry.published_at %}
    <pubDate>{{ entry.published_at.strftime('%a, %d %b %Y %H:%M:%S %z') }}</pubDate>
    {%- endif %}
    <description>{{ ((entry.summary or "") ~ " Original post: " ~ entry.social_url ~ meeting_note)|e }}</description>
  </item>
{%- endfor %}
</channel>
</rss>
