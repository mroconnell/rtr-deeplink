# Copy to .env and fill in for local dev if you want to point at a real
# Postgres instance. If unset, the app falls back to a local SQLite file
# (dev.db) automatically -- no setup needed to just run the app.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret for GET /admin/stats?token=... . Any string works; treat it
# like a password. Leave unset to disable the route entirely (it 404s).
ADMIN_STATS_TOKEN=changeme

# Resend (resend.com) API key + audience ID for the newsletter signup form.
# Leave unset locally if you're not testing that flow -- signups just
# return a "not available right now" message instead of erroring.
# The key MUST be created with "Full access" in Resend's dashboard --
# a "Sending access"-only key gets rejected on the audiences/contacts
# endpoint with 401 restricted_api_key. Permission level can't be
# changed on an existing key; create a new one and revoke the old.
RESEND_API_KEY=re_xxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Analytics 4 measurement ID. Leave unset to skip loading GA
# entirely -- window.trackEvent still exists either way (as a no-op), so
# event-tracking call sites never need to check whether GA is configured.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Base URL of the Archive service (see archive/) -- used to check for and
# push to permanent meeting pages. Leave unset to disable the integration
# entirely: /api/resolve just always live-resolves, same as before this
# feature existed. Locally, point this at your second local uvicorn process
# (e.g. http://localhost:8020). ARCHIVE_INGEST_TOKEN must match the same
# value set on the Archive service -- it's a shared secret, not a per-side
# credential.
ARCHIVE_BASE_URL=http://localhost:8020
ARCHIVE_INGEST_TOKEN=changeme

# New here 2026-08-10, for Clerk's authorized_parties check (see the Clerk
# section below) -- the resolver's own real public origin, so a session
# token issued for a different app/origin can't be replayed against this
# one. Leave unset locally; the Clerk helper falls back to common
# localhost dev origins when this is empty.
PUBLIC_BASE_URL=

# worker/ only. A real email address the worker uses as the requester on
# self-generated ("auto-idle-time") transcription jobs -- see
# BACKLOG_DONE.md's auto-idle-time entry for why this exists (the
# requester_email column is required, and the worker emails it on job
# completion, so this doubles as a lightweight activity digest). Leave
# unset to disable auto-generation entirely -- the worker only ever
# processes real user-submitted jobs, same as before this feature existed.
AUTO_TRANSCRIPTION_REQUESTER_EMAIL=you@example.com

# Clerk (accounts, 2026-08-10) -- see BACKLOG.md's "Accounts + token
# billing" section for why this app uses a third-party auth provider
# instead of hand-rolled sessions. Leave all three unset to disable
# accounts entirely: every Save button / nav sign-in link just doesn't
# render, and get_clerk_user_id() always returns None -- the rest of the
# site is completely unaffected (see this feature's own "nothing existing
# gets gated behind login" design note).
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Optional. Clerk's PEM public key (dashboard -> API Keys -> Advanced,
# "JWT public key") -- if set, session verification is truly networkless
# from the very first request. If unset, verification still works, just
# fetches and caches Clerk's JWKS on the first request per signing key
# (clerk_backend_api's own internal cache), a real but small and rare
# cold-start cost, not a per-request one.
CLERK_JWT_KEY=
# Resolver only -- from Clerk's dashboard, Webhooks -> your endpoint ->
# Signing Secret. Verifies POST /api/clerk/webhook payloads are really
# from Clerk (via the svix package) before trusting a user.created/
# user.deleted event.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxx
