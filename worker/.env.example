# The transcription worker reaches into the Archive's database directly
# (see worker/main.py's module docstring for why) -- this MUST be the
# exact same DATABASE_URL as the rtr-archive service, not a separate
# database. If unset, falls back to the same local SQLite file
# archive/db/engine.py defaults to (archive_dev.db in the repo root) --
# only works locally if you're running this worker from the repo root
# alongside a local archive service using its own default.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Same Resend account/config as archive/.env.example -- copy the same
# values here. The worker needs its own copy since it sends the
# transcription-complete email directly (imports archive.utils.email as a
# library, doesn't go through the Archive's HTTP API for this).
RESEND_API_KEY=re_xxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO_ADDRESS=

# Same as archive/.env.example -- used to build the link back to a
# meeting page in the completion email.
PUBLIC_BASE_URL=https://redtaperecordings.com
